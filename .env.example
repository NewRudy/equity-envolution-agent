# Optional PaddleOCR hosted API token. Documents are sent to PaddleOCR's service only
# when this is set and a PDF is submitted for parsing.
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
INSTALL_PADDLEOCR_API=0

# Optional app passcode. Leave empty for private localhost/SSH-tunnel deployment.
APP_PASSWORD=
